    function escapeHtml(text) {
        if (!text) return "";
        return String(text)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
    }

    function capitalizeWords(str) {
        if (!str) return "";
        return str.replace(/(^|[\s\-\'‘`ʻ])([a-zа-яёўқғҳ])/gi, (m, prefix, char) => prefix + char.toUpperCase());
    }

    function formatPhoneNumber(val) {
        let digits = val.replace(/\D/g, '');
        if (!digits.startsWith('998')) {
            digits = '998' + digits;
        }
        digits = digits.substring(0, 12);

        let res = '+998';
        if (digits.length > 3) res += ' ' + digits.substring(3, 5);
        if (digits.length > 5) res += ' ' + digits.substring(5, 8);
        if (digits.length > 8) res += ' ' + digits.substring(8, 10);
        if (digits.length > 10) res += ' ' + digits.substring(10, 12);
        return res;
    }

    const form = document.getElementById('admissionForm');
    const modal = document.getElementById('successModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const parentInput = document.getElementById('parentName');
    const childInput = document.getElementById('childName');
    const phoneInput = document.getElementById('phoneNumber');

    // Auto capitalize names on typing
    [parentInput, childInput].forEach(inp => {
        if (!inp) return;
        inp.addEventListener('input', () => {
            const start = inp.selectionStart;
            const end = inp.selectionEnd;
            const original = inp.value;
            const capitalized = capitalizeWords(original);
            if (original !== capitalized) {
                inp.value = capitalized;
                inp.setSelectionRange(start, end);
            }
        });
        inp.addEventListener('blur', () => {
            inp.value = capitalizeWords(inp.value.trim());
        });
    });

    // Auto format phone number with +998 prefix
    if (phoneInput) {
        if (!phoneInput.value || !phoneInput.value.startsWith('+998')) {
            phoneInput.value = '+998 ';
        }

        phoneInput.addEventListener('input', () => {
            phoneInput.value = formatPhoneNumber(phoneInput.value);
        });

        phoneInput.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && phoneInput.selectionStart <= 5 && phoneInput.selectionEnd <= 5) {
                e.preventDefault();
            }
        });

        phoneInput.addEventListener('focus', () => {
            if (!phoneInput.value || !phoneInput.value.startsWith('+998')) {
                phoneInput.value = '+998 ';
            }
            setTimeout(() => {
                if (phoneInput.selectionStart < 5) {
                    phoneInput.setSelectionRange(phoneInput.value.length, phoneInput.value.length);
                }
            }, 0);
        });

        phoneInput.addEventListener('click', () => {
            if (phoneInput.selectionStart < 5) {
                phoneInput.setSelectionRange(phoneInput.value.length, phoneInput.value.length);
            }
        });
    }

    if (form) {
        form.addEventListener('reset', () => {
            setTimeout(() => {
                if (phoneInput) phoneInput.value = '+998 ';
            }, 0);
        });

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const parent = capitalizeWords(document.getElementById('parentName').value.trim());
            const child = capitalizeWords(document.getElementById('childName').value.trim());
            const phone = document.getElementById('phoneNumber').value.trim();
            const grade = document.getElementById('gradeLevel').value;

            if (!parent || !child || !phone || !grade) {
                alert("Iltimos, barcha majburiy maydonlarni to'ldiring!");
                return;
            }

            const phoneDigits = phone.replace(/\D/g, '');
            if (phoneDigits.length < 12) {
                alert("Iltimos, telefon raqamingizni to'liq kiriting (masalan: +998 90 123 45 67)!");
                return;
            }

            const submitBtn = form.querySelector('button[type="submit"]');
            const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Yuborilmoqda...';
            }

            try {
                if (TELEGRAM_CONFIG.token && TELEGRAM_CONFIG.token.trim() !== "") {
                    const now = new Date();
                    const timeStr = now.toLocaleDateString('uz-UZ', { day: '2-digit', month: '2-digit', year: 'numeric' }) + 
                                    ' ' + now.toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit' });

                    const oneTimeToken = 'join_' + Math.random().toString(36).substring(2, 8) + Date.now().toString(36).substring(4);
                    const botDeepLink = `https://t.me/al_khorazmiy_registration_bot?start=${oneTimeToken}`;
                    const modalBotLink = document.getElementById('modalBotLink');
                    if (modalBotLink) {
                        modalBotLink.href = botDeepLink;
                    }

                    const messageText = 
                        `🎓 <b>YANGI QABUL ARIZASI!</b>\n` +
                        `🏫 <b>Al-Khorazmiy International School</b>\n` +
                        `━━━━━━━━━━━━━━━━━━━━━\n` +
                        `👤 <b>Ota-ona F.I.Sh:</b> ${escapeHtml(parent)}\n` +
                        `👶 <b>Farzand F.I.Sh:</b> ${escapeHtml(child)}\n` +
                        `📞 <b>Telefon raqam:</b> ${escapeHtml(phone)}\n` +
                        `📚 <b>Qaysi sinfga:</b> ${escapeHtml(grade)}-sinf\n` +
                        `⏰ <b>Yuborilgan vaqt:</b> ${timeStr}\n` +
                        `🔑 <b>1 martalik token:</b> <code>${oneTimeToken}</code>\n` +
                        `━━━━━━━━━━━━━━━━━━━━━\n` +
                        `📍 <i>Kanal: ${TELEGRAM_CONFIG.chatId}</i>`;

                    const telegramUrl = `https://api.telegram.org/bot${TELEGRAM_CONFIG.token.trim()}/sendMessage`;

                    const response = await fetch(telegramUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            chat_id: TELEGRAM_CONFIG.chatId,
                            text: messageText,
                            parse_mode: 'HTML'
                        })
                    });

                    const resData = await response.json();
                    if (!resData.ok) {
                        console.error('Telegram API xatoligi:', resData);
                        alert("Telegram kanalga yuborishda xatolik yuz berdi: " + (resData.description || "Noma'lum xatolik") + 
                              "\n\n(Eslatma: Bot kanalga admin qilib qo'shilgan bo'lishi va xabar yuborish huquqiga ega bo'lishi shart!)");
                    }
                } else {
                    console.warn("Telegram bot tokeni hali kiritilmagan. TELEGRAM_CONFIG.token o'zgaruvchisiga bot tokenini kiriting.");
                }

                modal.classList.add('show');
                form.reset();
                if (phoneInput) phoneInput.value = '+998 ';
            } catch (err) {
                console.error("Xatolik:", err);
                alert("Arizani yuborishda xatolik yuz berdi. Iltimos, internetingizni tekshirib qayta urinib ko'ring.");
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnHtml;
                }
            }
        });
    }

    if (closeModalBtn) {
