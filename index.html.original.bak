<!-- FAQ (KO'P BERILADIGAN SAVOLLAR) ACCORDION SECTION -->
<section id="faq">
    <div class="container">
        <div class="section-header center reveal-up">
            <div class="section-tag"><i class="fas fa-circle-question"></i> <span data-i18n="faq_tag">Savol-Javoblar</span></div>
            <h2 class="section-title" data-i18n="faq_title">Ko'p Beriladigan <span>Muhim Savollar</span></h2>
            <p class="section-sub" data-i18n="faq_sub">Ota-onalar tomonidan eng ko'p beriladigan savollarga mutaxassislarimizdan aniq va batafsil javoblar</p>
        </div>
        
        <div class="faq-wrapper">
            <!-- FAQ 1 -->
            <div class="faq-item reveal-up delay-1">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q1">Al-Khorazmiy School'da yotoqxona bormi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a1">
                        Maktabimizda uzoq tuman va viloyatlardan kelgan o'quvchilar uchun barcha sharoitlarga ega, xavfsiz va shinam yotoqxona (pansionat) mavjud. Yotoqxonada 24/7 tarbiyachi-ustozlar nazorati va qat'iy qo'riqlash xizmati ta'minlangan. Shuningdek, Namangan shahri va yaqin hududlardan qatnovchi o'quvchilar uchun xavfsiz avtobus (transport) xizmati yo'lga qo'yilgan.
                    </p>
                </div>
            </div>

            <!-- FAQ 2 (8-11 SINF VA UNIVERSITETGA TAYYORLASH) -->
            <div class="faq-item reveal-up delay-2">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q2">8-11 sinf o'quvchilari universitetlarga qanday tayyorlanadi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a2">
                        8-11 sinf o'quvchilari uchun maxsus "College Counseling" (OTMlarga yo'naltirish) dasturi yo'lga qo'yilgan. O'quvchilar xalqaro IELTS (7.5+) va SAT imtihonlariga intensiv tayyorlanadi. Mahalliy (TDIU, WIUT, INHA, AKFA) hamda xalqaro (AQSH, Buyuk Britaniya, Yevropa, Yaponiya) universitetlarga 100% grant yutish, motivatsion xatlar yozish va xalqaro talablarga mos portfolio shakllantirishda to'liq professional ko'mak beriladi.
                    </p>
                </div>
            </div>

            <!-- FAQ 3 (DIPLOM VA ATTESTAT) -->
            <div class="faq-item reveal-up delay-3">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q3">Maktab bitiruvchilariga qanday attestat yoki diplom beriladi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a3">
                        Maktabimiz davlat akkreditatsiyasidan o'tgan bo'lib, barcha 11-sinf bitiruvchilariga O'zbekiston Respublikasi davlat namunasidagi rasmiy umumiy o'rta ta'lim attestati (oltin yoki kumush medal bilan) beriladi. Bundan tashqari, xalqaro IELTS, SAT va STEM sertifikatlari taqdim etilib, o'quvchilar dunyo va O'zbekiston OTMlariga imtihonsiz yoki imtiyozli qabul qilinish imkoniyatiga ega bo'ladilar.
                    </p>
                </div>
            </div>

            <!-- FAQ 4 -->
            <div class="faq-item reveal-up delay-1">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q4">Pulni bo'lib to'lash imkoniyati bormi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a4">
                        Ha, albatta! Ota-onalarimizga qulaylik yaratish maqsadida o'qish to'lovini oylik, choraklik yoki yillik tarzda bo'lib to'lash imkoniyati mavjud. Yillik to'lovni bir martada amalga oshirgan oilalar uchun maxsus imtiyozli chegirma taqdim etiladi.
                    </p>
                </div>
            </div>

            <!-- FAQ 5 -->
            <div class="faq-item reveal-up delay-2">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q5">Narx tez-tez o'zgarib turadimi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a5">
                        Yo'q, o'quv yili boshida ikki tomonlama tuzilgan rasmiy shartnomada belgilangan o'qish to'lovi narxi butun o'quv yili davomida qat'iy o'zgarmasdan kafolatlanadi.
                    </p>
                </div>
            </div>

            <!-- FAQ 6 -->
            <div class="faq-item reveal-up delay-3">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q6">O'qituvchilar tajribalimi? Ular talabalar emasmi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a6">
                        Bizda talabalar dars bermaydi. Barcha 51 nafar pedagoglarimiz ko'p yillik tajribaga ega, oliy toifali mutaxassislar va xorijdan jalb qilingan 4 nafar xalqaro toifadagi Native Speaker o'qituvchilardir. Har bir o'qituvchi maxsus ko'p bosqichli imtihon va suhbat orqali saralab olinadi.
                    </p>
                </div>
            </div>

            <!-- FAQ 7 -->
            <div class="faq-item reveal-up delay-1">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q7">Maktabda necha mahal va qanday ovqat beriladi? Ular ishonchlimi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a7">
                        Maktabimizda kuniga 3 mahal issiq, to'yimli va muvozanatli halol taomlar beriladi. Taomnoma bolalar rivojlanishi va salomatligi uchun parhezshunos shifokorlar tomonidan tuziladi. Oshxona eng zamonaviy texnologiyalar bilan jihozlangan va barcha mahsulotlar har kuni qat'iy sanitariya-gigiyena nazoratidan o'tkaziladi.
                    </p>
                </div>
            </div>

            <!-- FAQ 8 (KUNDALIK VA BAHOLARNI KUZATISH) -->
            <div class="faq-item reveal-up delay-2">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q8">Ota-onalar farzandining baholari va davomatini qanday kuzatib boradi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a8">
                        Bizda innovatsion onlayn platforma va mobil kundalik tizimi yo'lga qo'yilgan. Ota-onalar o'z smartfonlari orqali farzandining har bir darsdagi baholari, darsga qatnashi, ustozlarning xulosalari va uy vazifalarini real vaqt rejimida (real-time) masofadan kuzatib borishlari mumkin.
                    </p>
                </div>
            </div>

            <!-- FAQ 9 -->
            <div class="faq-item reveal-up delay-3">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q9">Maktabda forma kiyish majburiymi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a9">
                        Ha, o'quvchilarimiz o'rtasida tenglik, jamoaviylik ruhi va estetik intizomni mustahkamlash maqsadida Al-Khorazmiy xalqaro maktabining maxsus zamonaviy va qulay yagona formasi joriy etilgan.
                    </p>
                </div>
            </div>

            <!-- FAQ 10 -->
            <div class="faq-item reveal-up delay-4">
                <div class="faq-header">
                    <span class="faq-question" data-i18n="faq_q10">Chegirmalar va grantlar bormi?</span>
                    <div class="faq-toggle-btn"><i class="fas fa-plus"></i></div>
                </div>
                <div class="faq-body">
                    <p class="faq-answer" data-i18n="faq_a10">
                        Ha! Bir oiladan 2 va undan ortiq farzand o'qisa oilaviy chegirmalar, shuningdek kirish imtihonlarida eng yuqori natija ko'rsatgan va fan olimpiadalari g'olibi bo'lgan iqtidorli o'quvchilar uchun 10% dan 50% gacha bo'lgan maxsus grant va chegirmalar mavjud.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ADMISSION -->
<section id="admission">
    <div class="container">
        <div class="section-header center">
            <div class="section-tag"><i class="fas fa-pen-to-square"></i> <span data-i18n="adm_tag">Qabul 2026-2027</span></div>
            <h2 class="section-title" data-i18n="adm_title">Farzandingizning <span>Katta Kelajagi</span> Shu Yerdan Boshlanadi</h2>
            <p class="section-sub" data-i18n="adm_sub">Yangi o'quv yiliga qabul jarayoni davom etmoqda. Joylar cheklangan!</p>
        </div>
        
        <div class="admission-wrapper">
            <div class="admission-info reveal-left">
                <div class="admission-steps">
                    <div class="step-item">
                        <div class="step-num">1</div>
                        <div class="step-content">
                            <strong data-i18n="adm_s1_title">Onlayn Ariza Qoldiring</strong>
                            <p data-i18n="adm_s1_desc">Quyidagi formani to'ldiring yoki ma'muriyat telefon raqamlari orqali bog'laning.</p>
                        </div>
                    </div>
                    <div class="step-item">
                        <div class="step-num">2</div>
                        <div class="step-content">
                            <strong data-i18n="adm_s2_title">Kirish Sinovi va Suhbat</strong>
                            <p data-i18n="adm_s2_desc">O'quvchining hozirgi bilim darajasi va qiziqishlarini aniqlash uchun do'stona suhbat.</p>
                        </div>
                    </div>
                    <div class="step-item">
                        <div class="step-num">3</div>
                        <div class="step-content">
                            <strong data-i18n="adm_s3_title">Maktab Bilan Yaqindan Tanishing</strong>
                            <p data-i18n="adm_s3_desc">Open Day — maktab hududi, laboratoriya va sinfxonalar bilan ota-onalar birgalikda tanishadilar.</p>
                        </div>
                    </div>
                    <div class="step-item" style="padding-bottom:0;">
                        <div class="step-num">4</div>
                        <div class="step-content">
                            <strong data-i18n="adm_s4_title">Shartnoma va O'qishni Boshlash</strong>
                            <p data-i18n="adm_s4_desc">Hujjatlarni rasmiylashtiring va farzandingiz yorqin kelajak sari ilk qadamni tashlasin!</p>
                        </div>
                    </div>
                </div>
                
                <div class="admission-deadlines">
                    <h4><i class="fas fa-clock"></i> <span data-i18n="adm_dates_title">Muhim Qabul Sanalari</span></h4>
                    <div class="deadline-row">
                        <span data-i18n="adm_d1">1-bosqich qabul (1-4 sinflar)</span>
                        <span class="deadline-date">15 Oktabr 2026</span>
                    </div>
                    <div class="deadline-row">
                        <span data-i18n="adm_d2">2-bosqich qabul (5-11 sinflar)</span>
                        <span class="deadline-date">30 Oktabr 2026</span>
                    </div>
                    <div class="deadline-row">
                        <span data-i18n="adm_d3">Darslarning boshlanishi</span>
                        <span class="deadline-date">3 Yanvar 2027</span>
                    </div>
                </div>
            </div>
            
            <div class="form-wrapper reveal-right">
                <h3 data-i18n="form_title">Qabulga Ariza Qoldirish</h3>
                <p class="form-sub" data-i18n="form_sub">Ma'lumotlaringizni qoldiring, mutaxassisimiz 24 soat ichida siz bilan bog'lanadi.</p>
                <form id="admissionForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label><span data-i18n="form_parent_name">Ota-ona F.I.Sh</span> <span>*</span></label>
                            <input type="text" id="parentName" class="form-control name-input" placeholder="Abdullayev Alisher" required autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label><span data-i18n="form_child_name">Farzand F.I.Sh</span> <span>*</span></label>
                            <input type="text" id="childName" class="form-control name-input" placeholder="Abdullayev Jasur" required autocomplete="off">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label><span data-i18n="form_phone">Telefon raqam</span> <span>*</span></label>
                        <input type="tel" id="phoneNumber" class="form-control" placeholder="+998 90 123 45 67" value="+998 " maxlength="17" required autocomplete="tel">
                    </div>
                    
                    <div>
                        <div class="form-group">
                            <label><span data-i18n="form_grade">Qaysi sinfga?</span> <span>*</span></label>
                            <select id="gradeLevel" class="form-control" required>
                                <option value="" disabled selected data-i18n="form_select_grade">Sinfni tanlang</option>
                                <option value="1">1-sinf</option>
                                <option value="2">2-sinf</option>
                                <option value="3">3-sinf</option>
                                <option value="4">4-sinf</option>
                                <option value="5">5-sinf</option>
                                <option value="6">6-sinf</option>
                                <option value="7">7-sinf</option>
                                <option value="8">8-sinf</option>
                                <option value="9">9-sinf</option>
                                <option value="10">10-sinf</option>
                                <option value="11">11-sinf</option>
                            </select>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-green form-submit">
                        <i class="fas fa-paper-plane"></i> <span data-i18n="form_btn_submit">Arizani Yuborish</span>
                    </button>
                    <p class="form-note"><i class="fas fa-shield-alt"></i> <span data-i18n="form_privacy">Ma'lumotlaringiz 100% maxfiy saqlanadi</span></p>
                </form>
            </div>
        </div>
    </div>
</section>

