<!-- HERO SECTION -->
<section id="hero">
    <div class="hero-bg"><img src="school_building.jpg" alt="Al-Khorazmiy Maktabi binosi"></div>
    <div class="container">
        <div class="hero-content">
            <div class="hero-left reveal-left">
                <div class="hero-badge" data-i18n="hero_badge">Namanganning №1 Xalqaro Maktabi</div>
                <h1 class="hero-title" data-i18n="hero_title">
                    Farzandingizga <span class="highlight">Xalqaro</span><br>Sifatli <span class="gold">Ta'lim</span> Bering
                </h1>
                <p class="hero-desc" data-i18n="hero_desc">
                    Al-Khorazmiy International School — zamonaviy texnologiyalar, chuqurlashtirilgan ingliz tili va STEM fanlari orqali farzandingizni dunyoga tayyorlaydigan innovatsion ta'lim markazi.
                </p>
                <div class="hero-actions">
                    <a href="#admission" class="btn btn-green"><i class="fas fa-pen-to-square"></i> <span data-i18n="hero_btn_apply">2026-2027 Qabulga Yozilish</span></a>
                    <a href="#about" class="btn btn-outline-white"><i class="fas fa-play-circle"></i> <span data-i18n="hero_btn_about">Maktab haqida</span></a>
                    <a href="#gallery" class="btn btn-outline-white"><i class="fas fa-images"></i> <span data-i18n="hero_btn_gallery">Yutuqlar (Galereya)</span></a>
                </div>
                
                <div class="hero-stats">
                    <div class="hstat-item">
                        <div class="hstat-num">450<span>+</span></div>
                        <div class="hstat-label" data-i18n="stat_students">O'quvchi o'rni</div>
                    </div>
                    <div class="hstat-item">
                        <div class="hstat-num">51<span>+</span></div>
                        <div class="hstat-label" data-i18n="stat_teachers">Malakali pedagog</div>
                    </div>
                    <div class="hstat-item">
                        <div class="hstat-num">4<span>+</span></div>
                        <div class="hstat-label" data-i18n="stat_foreign">Xorijlik mutaxassis</div>
                    </div>
                    <div class="hstat-item">
                        <div class="hstat-num">12<span> mlrd</span></div>
                        <div class="hstat-label" data-i18n="stat_invest">Investitsiya (so'm)</div>
                    </div>
                </div>
            </div>
            
            <div class="hero-right-grid reveal-right">
                <div class="hero-img-card">
                    <img src="students_classroom_1790344421651.png" alt="Sinfxona">
                    <div class="hero-img-label" data-i18n="hero_img_class">Zamonaviy sinfxonalar</div>
                </div>
                <div class="hero-img-card">
                    <img src="stem_lab_1790344438969.png" alt="STEM">
                    <div class="hero-img-label" data-i18n="hero_img_stem">STEM Laboratoriya</div>
                </div>
                <div class="hero-img-card">
                    <img src="sports_facility_1790344450271.png" alt="Sport">
                    <div class="hero-img-label" data-i18n="hero_img_sport">Sport majmuasi</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TICKER -->
<div class="ticker-bar">
    <div class="ticker-content">
        <span class="ticker-item"><i class="fas fa-star"></i> <span data-i18n="ticker_1">2026-2027 o'quv yili uchun qabul boshlandi!</span></span>
        <span class="ticker-item"><i class="fas fa-trophy"></i> <span data-i18n="ticker_2">Matematika va Fizika olimpiadalarida 1-o'rin!</span></span>
        <span class="ticker-item"><i class="fas fa-globe"></i> <span data-i18n="ticker_3">Native speaker xorijlik ingliz tili ustozlari</span></span>
        <span class="ticker-item"><i class="fas fa-award"></i> <span data-i18n="ticker_4">IELTS 7.0+ va xalqaro sertifikat natijalari</span></span>
        <span class="ticker-item"><i class="fas fa-bus"></i> <span data-i18n="ticker_5">Qumqo'rg'on va Namangan shahridan xavfsiz transport</span></span>
        <span class="ticker-item"><i class="fas fa-star"></i> <span data-i18n="ticker_1">2026-2027 o'quv yili uchun qabul boshlandi!</span></span>
        <span class="ticker-item"><i class="fas fa-trophy"></i> <span data-i18n="ticker_2">Matematika va Fizika olimpiadalarida 1-o'rin!</span></span>
    </div>
</div>

<!-- ABOUT SECTION -->
<section id="about">
    <div class="container">
        <div class="about-grid">
            <div class="about-images reveal-left">
                <div class="about-img-main"><img src="about_logo_card.png" alt="Al-Xorazmiy Maktabi"></div>
                <div class="about-img-small"><img src="library_1790344465892.png" alt="Kutubxona"></div>
                <div class="about-exp-badge"><strong>5+</strong><span data-i18n="about_exp">Yil tajriba</span></div>
            </div>
            
            <div class="about-text reveal-right">
                <div class="section-tag"><i class="fas fa-school"></i> <span data-i18n="about_tag">Biz haqimizda</span></div>
                <h2 class="section-title" data-i18n="about_title">Namanganning <span>ilg'or</span> xalqaro ta'lim maskani</h2>
                <p class="section-sub" data-i18n="about_desc">
                    Al-Xorazmiy nomidagi iqtidorli bolalar xalqaro maxsus maktabi — Namangan tumanidagi Qumqo'rg'on qishlog'ida tadbirkor Muhriddin Xojiakbarov tashabbusi bilan 12 milliard so'm investitsiya evaziga barpo etilgan. Farg'ona vodiysida birinchilardan bo'lib tashkil etilgan ushbu 450 o'rinli muassasada darslar bosqichma-bosqich ingliz tilida o'tiladi va ota-onalar uchun onlayn baholash tizimi yo'lga qo'yilgan.
                </p>
                
                <div class="about-features">
                    <div class="about-feature reveal-up delay-1">
                        <div class="about-feature-icon"><i class="fas fa-globe-americas"></i></div>
                        <div class="about-feature-text">
                            <strong data-i18n="feat_1_title">Xalqaro o'quv dasturi</strong>
                            <p data-i18n="feat_1_desc">Cambridge va ilg'or pedagogik standartlar, ingliz tilida chuqurlashtirilgan ta'lim.</p>
                        </div>
                    </div>
                    <div class="about-feature reveal-up delay-2">
                        <div class="about-feature-icon"><i class="fas fa-user-tie"></i></div>
                        <div class="about-feature-text">
                            <strong data-i18n="feat_2_title">4+ Xorijlik Native Speakerlar</strong>
                            <p data-i18n="feat_2_desc">Chet eldan jalb etilgan malakali mutaxassislar bilan jonli muloqot va amaliyot.</p>
                        </div>
                    </div>
                    <div class="about-feature reveal-up delay-3">
                        <div class="about-feature-icon"><i class="fas fa-microchip"></i></div>
                        <div class="about-feature-text">
                            <strong data-i18n="feat_3_title">STEM & Robototexnika</strong>
                            <p data-i18n="feat_3_desc">Axborot texnologiyalari, robotika va interfaol elektron doskalar bilan jihozlangan sinflar.</p>
                        </div>
                    </div>
                    <div class="about-feature reveal-up delay-4">
                        <div class="about-feature-icon"><i class="fas fa-mobile-alt"></i></div>
                        <div class="about-feature-text">
                            <strong data-i18n="feat_4_title">Onlayn nazorat tizimi</strong>
                            <p data-i18n="feat_4_desc">Ota-onalar farzandi baholarini xohlagan vaqtda smartfon ilovasi orqali ko'rib boradilar.</p>
                        </div>
                    </div>
                </div>
                
                <a href="#admission" class="btn btn-green"><i class="fas fa-paper-plane"></i> <span data-i18n="about_btn">Ariza topshirish</span></a>
            </div>
        </div>
    </div>
</section>

<!-- STATS COUNTER -->
<div class="stats-section">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item reveal-up delay-1">
                <div class="stat-icon"><i class="fas fa-user-graduate"></i></div>
                <div class="stat-number">450<span>+</span></div>
                <div class="stat-label" data-i18n="stat_box_students">Jami o'quvchi o'rni</div>
            </div>
            <div class="stat-item reveal-up delay-2">
                <div class="stat-icon"><i class="fas fa-chalkboard-teacher"></i></div>
                <div class="stat-number">51<span>+</span></div>
                <div class="stat-label" data-i18n="stat_box_teachers">Malakali pedagoglar</div>
            </div>
            <div class="stat-item reveal-up delay-3">
                <div class="stat-icon"><i class="fas fa-globe"></i></div>
                <div class="stat-number">4<span>+</span></div>
                <div class="stat-label" data-i18n="stat_box_foreign">Xorijlik Native Speaker</div>
            </div>
            <div class="stat-item reveal-up delay-4">
                <div class="stat-icon"><i class="fas fa-building"></i></div>
                <div class="stat-number">12<span> mlrd</span></div>
                <div class="stat-label" data-i18n="stat_box_invest">Investitsiya (so'm)</div>
            </div>
        </div>
    </div>
</div>

<!-- PROGRAMS -->
<section id="programs">
    <div class="container">
        <div class="section-header center reveal-up">
            <div class="section-tag"><i class="fas fa-book-open"></i> <span data-i18n="prog_tag">O'quv dasturlari</span></div>
            <h2 class="section-title" data-i18n="prog_main_title">Nima uchun aynan <span>Al-Khorazmiy?</span></h2>
            <p class="section-sub" data-i18n="prog_main_sub">Har bir yosh bosqichi uchun mukammal ishlab chiqilgan zamonaviy o'quv yo'nalishlarimiz</p>
        </div>
        
        <div class="programs-grid">
            <!-- 1-4 SINF: BOSHLANG'ICH -->
            <div class="program-card reveal-left delay-1" id="prog-primary">
                <div class="program-img">
                    <img src="students_classroom_1790344421651.png" alt="Boshlang'ich ta'lim">
                    <span class="program-tag" data-i18n="prog_1_tag">1-4 sinf</span>
                </div>
                <div class="program-body">
                    <div class="program-level" data-i18n="prog_1_level">Boshlang'ich ta'lim</div>
                    <h3 data-i18n="prog_1_h3">Poydevor — Kuchli Start</h3>
                    <p data-i18n="prog_1_p">O'yinli va interaktiv metodlar orqali matematika, mantiq, chet tillari va ijodiy fikrlash asoslari mustahkamlanadi.</p>
                    <div class="program-meta">
                        <div class="pmeta-item"><i class="fas fa-users"></i> <span data-i18n="prog_meta_students">Max 20 o'quvchi</span></div>
                        <div class="pmeta-item"><i class="fas fa-clock"></i> 8:00 – 16:30</div>
                    </div>
                </div>
            </div>
            
            <!-- 5-7 SINF: O'RTA TA'LIM -->
            <div class="program-card reveal-up delay-2" id="prog-middle">
                <div class="program-img">
                    <img src="library_1790344465892.png" alt="O'rta ta'lim">
                    <span class="program-tag" data-i18n="prog_2_tag">5-7 sinf</span>
                </div>
                <div class="program-body">
                    <div class="program-level" data-i18n="prog_2_level">O'rta ta'lim</div>
                    <h3 data-i18n="prog_2_h3">Chuqurlashtirilgan Fanlar & Mantiq</h3>
                    <p data-i18n="prog_2_p">Aniq va tabiiy fanlarni chuqur o'rganish, laboratoriya mashg'ulotlari, xalqaro fan olimpiadalariga professional tayyorgarlik va tanqidiy fikrlash.</p>
                    <div class="program-meta">
                        <div class="pmeta-item"><i class="fas fa-chart-line"></i> <span data-i18n="prog_meta_olympiad">Olimpiada tayyorlov</span></div>
                        <div class="pmeta-item"><i class="fas fa-brain"></i> Critical Thinking</div>
                    </div>
                </div>
            </div>
            
            <!-- 8-11 SINF: UNIVERSITETGA TAYYORLASH (ASOSIY!) -->
            <div class="program-card reveal-right delay-3" id="prog-high" style="border: 2px solid var(--brand-green);">
                <div class="program-img" style="position:relative;">
                    <img src="school_building.jpg" alt="8-11 sinf Universitetga tayyorlash" style="object-position:center top;">
                    <span class="program-tag" style="background:var(--brand-gold);color:#0f172a;font-weight:800;" data-i18n="prog_high_tag">8-11 sinf</span>
                </div>
                <div class="program-body">
                    <div class="program-level" style="color:var(--brand-gold-dark);" data-i18n="prog_high_level">Yuqori Ta'lim & Karyera</div>
                    <h3 data-i18n="prog_high_h3">Universitetga Tayyorlov (OTM & Grantlar)</h3>
                    <p data-i18n="prog_high_p">Xalqaro IELTS (7.5+), SAT, xorijiy va nufuzli O'zbekiston OTMlariga (WIUT, INHA, AKFA, TDIU) 100% grant yutish, kasbiy yo'naltirish va portfolio tayyorlash.</p>
                    <div class="program-meta">
                        <div class="pmeta-item"><i class="fas fa-graduation-cap"></i> SAT & IELTS 7.5+</div>
                        <div class="pmeta-item"><i class="fas fa-university"></i> OTM Grantlari</div>
                    </div>
                </div>
            </div>
            
            <!-- STEM & IT -->
            <div class="program-card reveal-left delay-1" id="prog-stem">
                <div class="program-img">
                    <img src="stem_lab_1790344438969.png" alt="STEM & Robotika">
                    <span class="program-tag" data-i18n="prog_3_tag">STEM & IT</span>
                </div>
                <div class="program-body">
                    <div class="program-level" data-i18n="prog_3_level">Ilmiy-Texnik Yo'nalish</div>
                    <h3 data-i18n="prog_3_h3">STEM, Robotika & Dasturlash</h3>
                    <p data-i18n="prog_3_p">Robototexnika, Python dasturlash, 3D muhandislik va amaliy fizika-kimyo laboratoriya eksperimentlari.</p>
                    <div class="program-meta">
                        <div class="pmeta-item"><i class="fas fa-robot"></i> Robotika & AI</div>
                        <div class="pmeta-item"><i class="fas fa-code"></i> Python Coding</div>
                    </div>
                </div>
            </div>
            
            <!-- INTENSIV CHET TILI -->
            <div class="program-card reveal-up delay-2" id="prog-english">
                <div class="program-img" style="background:linear-gradient(135deg, #091328, #162a56); display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-language" style="font-size:75px; color:rgba(24, 176, 173,0.5);"></i>
                    <span class="program-tag" data-i18n="prog_4_tag">Til ta'limi</span>
                </div>
                <div class="program-body">
                    <div class="program-level" data-i18n="prog_4_level">Xalqaro Standart</div>
                    <h3 data-i18n="prog_4_h3">Intensiv Ingliz Tili & Native Speakers</h3>
                    <p data-i18n="prog_4_p">4 nafar chet ellik Native speaker ustozlar bilan haftalik 8+ soat darslar, Speaking Club va IELTS 7.5+ sertifikat tayyorlovi.</p>
                    <div class="program-meta">
                        <div class="pmeta-item"><i class="fas fa-user-tie"></i> 4 Native Speakers</div>
                        <div class="pmeta-item"><i class="fas fa-award"></i> IELTS 7.5+</div>
                    </div>
                </div>
            </div>
            
            <!-- SPORT & LIDERLIK -->
            <div class="program-card reveal-right delay-3" id="prog-sport">
                <div class="program-img">
                    <img src="sports_facility_1790344450271.png" alt="Sport va yetakchilik">
                    <span class="program-tag" data-i18n="prog_5_tag">Sport & Liderlik</span>
                </div>
                <div class="program-body">
                    <div class="program-level" data-i18n="prog_5_level">Har Tomonlama Kamolot</div>
                    <h3 data-i18n="prog_5_h3">Sport, Notiqlik & Liderlik</h3>
                    <p data-i18n="prog_5_p">Futbol, shaxmat, stol tennisi, suzish, notiqlik san'ati va jamoaviy yetakchilik ko'nikmalarini shakllantirish.</p>
