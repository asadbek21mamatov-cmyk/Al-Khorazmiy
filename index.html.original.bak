                            <button class="lang-item" data-lang="ru"><img src="flag_ru.svg" alt="RU" class="flag-img"> <span>Русский</span></button>
                            <button class="lang-item" data-lang="en"><img src="flag_gb.svg" alt="EN" class="flag-img"> <span>English</span></button>
                        </div>
                    </div>
                    
                    <!-- Theme Toggle -->
                    <button class="ctrl-btn" id="themeToggleBtn" title="Tungi / Tongi rejim">
                        <i class="fas fa-moon" id="themeIcon"></i>
                    </button>
                </div>
                
                <button class="hamburger" id="hamburger"><span></span><span></span><span></span></button>
            </div>
        </div>
    </nav>
</div>

<!-- Mobile Menu -->
